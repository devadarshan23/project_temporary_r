{
  "app": "node bin/app.ts",
  "watch": {
    "include": [],
    "exclude": [
      "**"
    ]
  },
  "output": "cdk.out",
  "versionReporting": false,
  "pathMetadata": false,
  "assetMetadata": false,
  "notices": false,
  "lookups": false,
  "context": {
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": [
      "aws"
    ],
    "@aws-cdk/core:bootstrapQualifier": "reconcile"
  },
  "toolkitStackName": "CDKToolkit-reconcile"
}
